{
  "manifest_version": 3,
  "name": "Manual HU - Grabador",
  "version": "0.5.0",
  "description": "Registra pasos y evidencias de una ejecución para crear manuales profesionales por historia de usuario.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Manual HU",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
