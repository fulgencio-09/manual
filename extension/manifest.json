{
  "manifest_version": 3,
  "name": "Manual HU - Grabador",
  "version": "0.1.0",
  "description": "Registra pasos de una ejecución para crear manuales por historia de usuario.",
  "permissions": ["activeTab", "storage"],
  "action": {
    "default_title": "Manual HU",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}